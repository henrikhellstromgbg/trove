# Local SQLite (libSQL). The whole DB is one file in the repo (gitignored).
# Optional — defaults to file:./data/trove.db when unset.
# TROVE_DB_URL=file:./data/trove.db

# Uploaded files are stored on the local filesystem (gitignored).
# Optional — defaults to ./data/files when unset.
# TROVE_FILES_DIR=./data/files

# Clerk (auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Anthropic (answer, extract, enrich)
ANTHROPIC_API_KEY=

# Google Generative AI (embeddings)
GEMINI_API_KEY=

# Inngest (background jobs)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Resend (pipeline email delivery, optional)
RESEND_API_KEY=
RESEND_FROM="Trove <onboarding@resend.dev>"

# Slack (slack_channel source, poll mode, optional)
# Bot token from a Slack app with channels:history, groups:history, files:read.
# Invite the bot to each channel you add as a source.
SLACK_BOT_TOKEN=
